NODE_ENV=development
PORT=3000

# MongoDB: either MONGODB_URI, or host + database (+ username/password for Atlas).
# MONGODB_URI=mongodb://localhost:27017/dev-platform
MONGODB_HOST=localhost:27017
MONGODB_DATABASE=dev-platform
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis: either REDIS_URL, or host + port (+ username/password for Redis Cloud).
# Leave all empty to disable Redis/BullMQ (in-process notification queue).
# REDIS_URL=redis://localhost:6379
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Production: https://<service>.onrender.com (no trailing slash).
API_PUBLIC_URL=http://localhost:3000
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_SIGNED_URL_TTL_SECONDS=600
MEDIA_STORAGE_DIR=

# Required in production — Render disk is ephemeral; local media storage is lost on restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

AI_API_KEY=
