# iOS Simulator: localhost is the Mac. Android emulator rewrites it to 10.0.2.2.
# Physical device: set your computer's LAN IP, e.g. http://192.168.1.10:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Optional. Leave empty to skip push in local/dev builds.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_IOS_BUNDLE_ID=

